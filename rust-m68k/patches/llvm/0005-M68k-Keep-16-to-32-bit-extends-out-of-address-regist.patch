From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:57:35 +0000
Subject: [PATCH 5/8] [M68k] Keep 16-to-32-bit extends out of address registers

MOVZXd32d16 and MOVSXd32d16 could take an address register as their
destination, and expanded to AND.L or EXT.L on it. Neither exists for an
address register, so AND.L #$FFFF,%a1 was encoded as AND.L on %d1. A
fastcc call passing an i64 in %d0:%d1 and an i16 in %a1 lost the low
word of the i64 (Rust's fixed-precision float printing). The
destination is now a data register; register-spills.ll had nine of
these and is regenerated.

Team 3
---
 llvm/lib/Target/M68k/M68kInstrData.td         |   4 +-
 .../M68k/Data/zext-into-address-register.ll   |  33 +++++
 llvm/test/CodeGen/M68k/register-spills.ll     | 126 ++++++++++--------
 3 files changed, 103 insertions(+), 60 deletions(-)
 create mode 100644 llvm/test/CodeGen/M68k/Data/zext-into-address-register.ll

diff --git a/llvm/lib/Target/M68k/M68kInstrData.td b/llvm/lib/Target/M68k/M68kInstrData.td
index 06633a5183..d364551a33 100644
--- a/llvm/lib/Target/M68k/M68kInstrData.td
+++ b/llvm/lib/Target/M68k/M68kInstrData.td
@@ -614,7 +614,9 @@ foreach EXT = ["S", "Z"] in {
 
     def MOV#EXT#Xd16d8  : MxPseudoMove_RR<MxType16d,  MxType8d>;
     def MOV#EXT#Xd32d8  : MxPseudoMove_RR<MxType32d,  MxType8d>;
-    def MOV#EXT#Xd32d16 : MxPseudoMove_RR<MxType32r, MxType16r>;
+    // The destination is a data register: an address register can be neither
+    // zero- nor sign-extended in place (AND/EXT take data registers only).
+    def MOV#EXT#Xd32d16 : MxPseudoMove_RR<MxType32d, MxType16r>;
 
     let mayLoad = 1 in {
 
diff --git a/llvm/test/CodeGen/M68k/Data/zext-into-address-register.ll b/llvm/test/CodeGen/M68k/Data/zext-into-address-register.ll
new file mode 100644
index 0000000000..a4db2e6e5f
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Data/zext-into-address-register.ll
@@ -0,0 +1,33 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc < %s -mtriple=m68k -mcpu=M68040 -verify-machineinstrs | FileCheck %s
+
+; An i16 argument that fastcc passes in %a1 is zero-extended first. The
+; extension used to be allocated to %a1 itself and expanded to
+; "and.l #65535, %a1", which does not exist: it was encoded as an AND on
+; %d1 and wiped the low half of the i64 argument passed in %d0:%d1.
+
+declare fastcc void @callee(ptr, i64, i16)
+
+define void @caller(ptr %p, i64 %m, i16 %a, i16 %b) {
+; CHECK-LABEL: caller:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    suba.l #4, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -8
+; CHECK-NEXT:    movem.l %d2, (0,%sp) ; 8-byte Folded Spill
+; CHECK-NEXT:    move.w (22,%sp), %d0
+; CHECK-NEXT:    add.w (26,%sp), %d0
+; CHECK-NEXT:    move.l %d0, %d2
+; CHECK-NEXT:    and.l #65535, %d2
+; CHECK-NEXT:    move.l (8,%sp), %a0
+; CHECK-NEXT:    move.l (12,%sp), %d0
+; CHECK-NEXT:    move.l (16,%sp), %d1
+; CHECK-NEXT:    move.l %d2, %a1
+; CHECK-NEXT:    jsr callee
+; CHECK-NEXT:    movem.l (0,%sp), %d2 ; 8-byte Folded Reload
+; CHECK-NEXT:    adda.l #4, %sp
+; CHECK-NEXT:    rts
+  %x = add i16 %a, %b
+  call fastcc void @callee(ptr %p, i64 %m, i16 %x)
+  ret void
+}
