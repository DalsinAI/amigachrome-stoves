From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:30:46 +0000
Subject: [PATCH 1/8] [M68k] Keep the index register when the address base is a
 frame index

hasIndexReg() said no whenever the base was a frame index, so a stack
slot plus a register (an indexed stack buffer) was selected as a plain
(d16,%sp) and the register was dropped, and a second register could
overwrite the index. Every store into such a buffer landed at one fixed
offset. Rust's core::fmt integer formatting hit this.

A frame index base now never takes an index: matchAddressBase refuses
one so the frame address goes into a register, SelectARID checks the
index before taking the frame index, and SelectARII does not index a
frame index by a constant (that stays an ARID displacement).

Team 3
---
 llvm/lib/Target/M68k/M68kISelDAGToDAG.cpp     | 35 ++++++---
 .../M68k/Data/frame-index-plus-register.ll    | 71 +++++++++++++++++++
 2 files changed, 97 insertions(+), 9 deletions(-)
 create mode 100644 llvm/test/CodeGen/M68k/Data/frame-index-plus-register.ll

diff --git a/llvm/lib/Target/M68k/M68kISelDAGToDAG.cpp b/llvm/lib/Target/M68k/M68kISelDAGToDAG.cpp
index 9c3d61ec60..aca5d6e8fa 100644
--- a/llvm/lib/Target/M68k/M68kISelDAGToDAG.cpp
+++ b/llvm/lib/Target/M68k/M68kISelDAGToDAG.cpp
@@ -100,9 +100,9 @@ struct M68kISelAddressMode {
     return BaseType == Base::RegBase && BaseReg.getNode() != nullptr;
   }
 
-  bool hasIndexReg() const {
-    return BaseType == Base::RegBase && IndexReg.getNode() != nullptr;
-  }
+  // An index register can sit beside a frame index base too, so this must
+  // not look at BaseType: a frame index plus a register is not an ARID.
+  bool hasIndexReg() const { return IndexReg.getNode() != nullptr; }
 
   /// True if address mode type supports displacement
   bool isDispAddrType() const {
@@ -412,6 +412,12 @@ bool M68kDAGToDAGISel::foldOffsetIntoAddress(uint64_t Offset,
 bool M68kDAGToDAGISel::matchAddressBase(SDValue N, M68kISelAddressMode &AM) {
   // Is the base register already occupied?
   if (AM.hasBase()) {
+    // A frame index base only becomes a displacement from SP or FP, and
+    // only (d16,An) takes one: it cannot carry an index, so let the caller
+    // put the frame address in a register instead.
+    if (AM.hasFrameIndex())
+      return false;
+
     // If so, check to see if the scale index register is set.
     if (!AM.hasIndexReg()) {
       AM.IndexReg = N;
@@ -500,7 +506,8 @@ bool M68kDAGToDAGISel::matchAddressRecursively(SDValue N,
   case ISD::FrameIndex:
     if (AM.isDispAddrType() &&
         AM.BaseType == M68kISelAddressMode::Base::RegBase &&
-        AM.BaseReg.getNode() == nullptr && doesDispFitFI(AM)) {
+        AM.BaseReg.getNode() == nullptr && !AM.hasIndexReg() &&
+        doesDispFitFI(AM)) {
       AM.BaseType = M68kISelAddressMode::Base::FrameIndexBase;
       AM.BaseFrameIndex = cast<FrameIndexSDNode>(N)->getIndex();
       return true;
@@ -735,17 +742,17 @@ bool M68kDAGToDAGISel::SelectARID(SDNode *Parent, SDValue N, SDValue &Disp,
     return false;
   }
 
+  if (AM.hasIndexReg()) {
+    LLVM_DEBUG(dbgs() << "REJECT: Cannot match Index\n");
+    return false;
+  }
+
   // If this is a frame index, grab it
   if (getFrameIndexAddress(AM, SDLoc(N), Disp, Base)) {
     LLVM_DEBUG(dbgs() << "SUCCESS matched FI\n");
     return true;
   }
 
-  if (AM.hasIndexReg()) {
-    LLVM_DEBUG(dbgs() << "REJECT: Cannot match Index\n");
-    return false;
-  }
-
   if (!AM.hasBaseReg()) {
     LLVM_DEBUG(dbgs() << "REJECT: No Base reg\n");
     return false;
@@ -825,6 +832,16 @@ bool M68kDAGToDAGISel::SelectARII(SDNode *Parent, SDValue N, SDValue &Disp,
     return false;
   }
 
+  // A frame index plus a constant is a displacement from SP or FP (ARID);
+  // never load the constant into a register to index it.
+  auto IsFI = [](SDValue V) { return isa<FrameIndexSDNode>(V); };
+  auto IsConst = [](SDValue V) { return isa<ConstantSDNode>(V); };
+  if ((IsFI(AM.BaseReg) && IsConst(AM.IndexReg)) ||
+      (IsConst(AM.BaseReg) && IsFI(AM.IndexReg))) {
+    LLVM_DEBUG(dbgs() << "REJECT: Frame index plus constant\n");
+    return false;
+  }
+
   if (!isAddressBase(AM.BaseReg) && isAddressBase(AM.IndexReg)) {
     Base = AM.IndexReg;
     Index = AM.BaseReg;
diff --git a/llvm/test/CodeGen/M68k/Data/frame-index-plus-register.ll b/llvm/test/CodeGen/M68k/Data/frame-index-plus-register.ll
new file mode 100644
index 0000000000..0d0777bf16
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Data/frame-index-plus-register.ll
@@ -0,0 +1,71 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc < %s -mtriple=m68k -mcpu=M68040 -verify-machineinstrs | FileCheck %s
+
+; A stack slot plus a register offset must keep the register. The address
+; matcher used to drop the index when the base was a frame index and select
+; a plain (d16,%sp), so every store below landed at the same constant
+; offset (Rust's core::fmt integer formatting hit this).
+
+declare void @use(ptr)
+
+define void @store_indexed(i32 %i, i8 %v) {
+; CHECK-LABEL: store_indexed:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    suba.l #36, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -40
+; CHECK-NEXT:    lea (4,%sp), %a0
+; CHECK-NEXT:    move.l (40,%sp), %a1
+; CHECK-NEXT:    move.b (47,%sp), (0,%a1,%a0)
+; CHECK-NEXT:    move.l %a0, (%sp)
+; CHECK-NEXT:    jsr use
+; CHECK-NEXT:    adda.l #36, %sp
+; CHECK-NEXT:    rts
+  %buf = alloca [32 x i8], align 1
+  %p = getelementptr inbounds i8, ptr %buf, i32 %i
+  store i8 %v, ptr %p, align 1
+  call void @use(ptr %buf)
+  ret void
+}
+
+define void @lea_indexed(i32 %i) {
+; CHECK-LABEL: lea_indexed:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    suba.l #36, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -40
+; CHECK-NEXT:    lea (4,%sp), %a0
+; CHECK-NEXT:    move.l %a0, %d0
+; CHECK-NEXT:    add.l (40,%sp), %d0
+; CHECK-NEXT:    move.l %d0, (%sp)
+; CHECK-NEXT:    jsr use
+; CHECK-NEXT:    adda.l #36, %sp
+; CHECK-NEXT:    rts
+  %buf = alloca [32 x i8], align 1
+  %p = getelementptr inbounds i8, ptr %buf, i32 %i
+  call void @use(ptr %p)
+  ret void
+}
+
+define i8 @load_indexed_disp(i32 %i) {
+; CHECK-LABEL: load_indexed_disp:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    suba.l #44, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -48
+; CHECK-NEXT:    movem.l %a2, (40,%sp) ; 8-byte Folded Spill
+; CHECK-NEXT:    lea (8,%sp), %a2
+; CHECK-NEXT:    move.l %a2, (%sp)
+; CHECK-NEXT:    jsr use
+; CHECK-NEXT:    move.l (48,%sp), %a0
+; CHECK-NEXT:    move.b (4,%a0,%a2), %d0
+; CHECK-NEXT:    movem.l (40,%sp), %a2 ; 8-byte Folded Reload
+; CHECK-NEXT:    adda.l #44, %sp
+; CHECK-NEXT:    rts
+  %buf = alloca [32 x i8], align 1
+  call void @use(ptr %buf)
+  %q = getelementptr inbounds i8, ptr %buf, i32 %i
+  %p = getelementptr inbounds i8, ptr %q, i32 4
+  %v = load i8, ptr %p, align 1
+  ret i8 %v
+}
