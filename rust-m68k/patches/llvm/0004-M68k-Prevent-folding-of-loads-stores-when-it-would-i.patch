+                                  (store (i32 (unindexedload node:$src)),
+                                         node:$dst),[{ return isSafeStoreLoad(N); }]>;
+
 def Mxloadi8         : PatFrag<(ops node:$ptr), (i8  (load node:$ptr))>;
 
 def MxSExtLoadi16i8  : PatFrag<(ops node:$ptr), (i16 (sextloadi8 node:$ptr))>;
